{
  "name": "handicraft-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "turbo run lint && eslint scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:build": "tsx scripts/build-registry.ts",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:perf": "playwright test --project=perf",
    "test:e2e:docker": "bash scripts/e2e-docker.sh e2e",
    "test:e2e:docker:visual": "bash scripts/e2e-docker.sh visual",
    "test:e2e:update": "bash scripts/e2e-docker.sh e2e --update-snapshots=all",
    "test:e2e:update:visual": "bash scripts/e2e-docker.sh visual --update-snapshots=all"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@handicraft/eslint-config": "workspace:*",
    "@handicraft/typescript-config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
