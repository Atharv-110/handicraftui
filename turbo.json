{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".prettierrc.json",
    "packages/typescript-config/*.json",
    "packages/eslint-config/*.js"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".next-dev/**", "!.next-dev/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  },
  "globalEnv": ["NODE_ENV"]
}
