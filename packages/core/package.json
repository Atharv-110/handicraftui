{
  "name": "@handicraft/core",
  "version": "0.0.0",
  "description": "Sketch rendering engine, tokens and primitives for Handicraft UI — hand-drawn React components.",
  "license": "MIT",
  "author": "Atharv Vani",
  "homepage": "https://handicraftui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atharv-110/handicraftui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Atharv-110/handicraftui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "hand-drawn",
    "sketchy",
    "roughjs",
    "tailwind",
    "shadcn",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./styles.css": "./dist/handicraft.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "roughjs": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "roughjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@handicraft/eslint-config": "workspace:*",
    "@handicraft/typescript-config": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^10.8.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "roughjs": "^4.6.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
